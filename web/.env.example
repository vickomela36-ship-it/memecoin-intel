# ─────────────────────────────────────────────────────────────────────────────
# Memecoin Intel — environment variables
#
# Import this straight into Vercel:
#   Vercel → Project → Settings → Environment Variables → "Import .env"
#   (paste or upload this file), fill in the values, pick Production + Preview,
#   then REDEPLOY (env vars only bind on a fresh build).
#
# Everything is optional — each feature stays dormant (never errors) until its
# key is set. Check what's live in-app under  ? (help) → STATUS.
# Lines starting with # are comments; delete a block you don't use.
# ─────────────────────────────────────────────────────────────────────────────

# ── Persistence — Postgres (Neon free tier) ─────────────────────────────────
# Powers: call ledger, KOL track-record, creator/cluster tracking, trenches
# heat gauge, cross-device sync. Get a pooled connection string from neon.tech.
# (If you instead connect Neon via the Vercel integration, it injects
#  POSTGRES_URL automatically and you can leave DATABASE_URL blank.)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Social signal — LunarCrush ──────────────────────────────────────────────
# Powers: bot filter, early-poster ranking, KOL ledger, coordinated-KOL.
LUNARCRUSH_API_KEY=

# ── Graduation feed — PumpPortal ────────────────────────────────────────────
# Powers: pump.fun graduation-rate in the trenches heat gauge (needs the daily
# /api/cron/graduations cron, already in vercel.json).
PUMPPORTAL_API_KEY=

# ── Email digest — Resend ───────────────────────────────────────────────────
# Powers /api/email-digest: ATH picks (with profit targets) + top pick per tier.
# RESEND_FROM must be on a domain you've verified in Resend.
# DIGEST_TO: recipient(s), comma-separated. DIGEST_SECRET guards the endpoint.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Memecoin Intel <digest@yourdomain.com>
DIGEST_TO=you@example.com
DIGEST_SECRET=change-me-to-a-long-random-string

# ── On-chain + market data (optional — bundled fallback keys work) ───────────
# Set your own to avoid shared-key rate limits.
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# ── Telegram alerts (optional) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Guards the manual /api/alerts trigger, if you use it.
ALERTS_SECRET=

# ── Call-ledger webhook (optional) ──────────────────────────────────────────
# If set, POST /api/calls ingest requests must include this as "secret".
CALLS_INGEST_SECRET=

# ── Alternative social worker (optional — only if you self-host Agent-Reach) ─
# LunarCrush above is the simpler path; set these only if running your own X
# scraper worker. If both are set, LunarCrush is tried first.
XREACH_URL=
XREACH_TOKEN=
